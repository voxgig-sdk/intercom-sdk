      h: "Html"
      n: "html"
      r: true
      sh: "The body of the external page in HTML."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The unique identifier for the external page which is given by Intercom."
      t: "`$STRING`"
    }
    last_ingested_at: {
      fo: "date-time"
      h: "Last Ingested At"
      n: "last_ingested_at"
      r: true
      sh: "The time when the external page was last ingested."
      t: "`$INTEGER`"
    }
    locale: {
      h: "Locale"
      n: "locale"
      r: true
      sh: "Always en"
      t: "`$STRING`"
    }
    source_id: {
      h: "Source Id"
      n: "source_id"
      r: true
      sh: "The unique identifier for the source of the external page which was given by Intercom."
      t: "`$INTEGER`"
    }
    title: {
      h: "Title"
      n: "title"
