# Entity: external_page

main: kit: entity: external_page: {

  alias: field: {}

  fields: {
    ai_agent_availability: {
      h: "Ai Agent Availability"
      n: "ai_agent_availability"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Whether the external page should be used to answer questions by AI Agent."
      t: "`$BOOLEAN`"
    }
    ai_copilot_availability: {
      h: "Ai Copilot Availability"
      n: "ai_copilot_availability"
      op: {
        create: {
