      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "Always external_page"
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "The time when the external page was last updated."
      t: "`$INTEGER`"
    }
    url: {
      h: "Url"
      n: "url"
      op: {
        update: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "The URL of the external page."
      t: "`$STRING`"
    }
  }

