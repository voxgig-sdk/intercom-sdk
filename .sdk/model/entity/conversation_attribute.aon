            json: "{\"operationId\":\"deleteConversationAttribute\",\"parameters\":[{\"in\":\"header\",\"name\":\"Intercom-Version\",\"schema\":{\"default\":\"2.16\",\"description\":\"Intercom API version.</br>By default, it's equal to the version set in the app package.\",\"enum\":[\"1.0\",\"1.1\",\"1.2\",\"1.3\",\"1.4\",\"2.0\",\"2.1\",\"2.2\",\"2.3\",\"2.4\",\"2.5\",\"2.6\",\"2.7\",\"2.8\",\"2.9\",\"2.10\",\"2.11\",\"2.12\",\"2.13\",\"2.14\",\"2.15\",\"2.16\"],\"example\":\"2.16\",\"type\":\"string\"}},{\"description\":\"The conversation attribute id\",\"example\":8,\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"Successful response\":{\"value\":{\"admin_id\":\"16\",\"archived\":true,\"created_at\":1778239701,\"data_type\":\"string\",\"description\":\"Updated via API\",\"id\":8,\"multiline\":false,\"name\":\"api_test_renamed\",\"required\":false,\"type\":\"conversation_attribute\",\"updated_at\":1778239721,\"visible_to_team_ids\":[]}}},\"schema\":{\"description\":\"Conversation Attributes represent custom metadata fields for conversations. They support type-specific properties: strings (multiline), lists (options), and relationships (reference).\",\"discriminator\":{\"mapping\":{\"boolean\":\"#/components/schemas/conversation_attribute_boolean_type\",\"datetime\":\"#/components/schemas/conversation_attribute_datetime_type\",\"decimal\":\"#/components/schemas/conversation_attribute_decimal_type\",\"files\":\"#/components/schemas/conversation_attribute_files_type\",\"integer\":\"#/components/schemas/conversation_attribute_integer_type\",\"list\":\"#/components/schemas/conversation_attribute_list_type\",\"relationship\":\"#/components/schemas/conversation_attribute_relationship_type\",\"string\":\"#/components/schemas/conversation_attribute_string_type\"},\"propertyName\":\"data_type\"},\"oneOf\":[{\"allOf\":[{\"properties\":{\"admin