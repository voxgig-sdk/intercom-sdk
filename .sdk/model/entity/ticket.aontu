      t: "`$OBJECT`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      sh: "The time the ticket was created as a UTC Unix timestamp."
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The unique identifier for the ticket which is given by Intercom."
      t: "`$STRING`"
    }
    is_shared: {
      h: "Is Shared"
      n: "is_shared"
      r: false
      sh: "Whether or not the ticket is shared with the customer."
      t: "`$BOOLEAN`"
    }
    linked_objects: {
      h: "Linked Objects"
      n: "linked_objects"
      r: false
      sh: "An object containing metadata about linked conversations and linked tickets."
      t: "`$OBJECT`"
    }
    open: {
      h: "Open"
      n: "open"
      r: false
      sh: "Whether or not the ticket is open."
      t: "`$BOOLEAN`"
    }
    previous_ticket_state_id: {
      h: "Previous Ticket State Id"
      n: "previous_ticket_state_id"
      r: false
      sh: "The ID of the previous ticket state from the most recent state change."
      t: "`$STRING`"
    }
    skip_notifications: {
      h: "Skip Notifications"
      n: "skip_notifications"
      r: false
      sh: "Option to disable notifications when a Ticket is created."
      t: "`$BOOLEAN`"
    }
