      h: "Team Assignee Id"
      n: "team_assignee_id"
      r: false
      sh: "The id representing the team assigned to the ticket."
      t: "`$INTEGER`"
    }
    ticket_attributes: {
      h: "Ticket Attributes"
      n: "ticket_attributes"
      r: false
      sh: "An object containing the different attributes associated to the ticket as key-value pairs."
      t: "`$OBJECT`"
      union: {
        branches: 5
        count: 1
        depth: 1
      }
    }
    ticket_id: {
      h: "Ticket Id"
      n: "ticket_id"
      r: false
      sh: "The ID of the Ticket used in the Intercom Inbox and Messenger."
      t: "`$STRING`"
    }
    ticket_parts: {
      h: "Ticket Parts"
      n: "ticket_parts"
      r: false
      sh: "A list of Ticket Part objects for each note and event in the ticket."
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 2
        depth: 9
      }
    }
    ticket_state: {
      h: "Ticket State"
      n: "ticket_state"
      r: false
      sh: "A ticket state, used to define the state of a ticket."
      t: "`$OBJECT`"
    }
    ticket_state_id: {
      h: "Ticket State Id"
      n: "ticket_state_id"
      r: false
      sh: "The ID of the ticket state associated with the ticket type."
      t: "`$STRING`"
    }
    ticket_type: {
      h: "Ticket Type"
      n: "ticket_type"
      r: false
      sh: "A ticket type, used to define the data fields to be captured in a ticket."
      t: "`$OBJECT`"
    }
    ticket_type_id: {
      h: "Ticket Type Id"
      n: "ticket_type_id"
      r: true
      sh: "The ID of the type of ticket you want to convert the conversation to"
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "Always ticket"
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "The last time the ticket was updated as a UTC Unix timestamp."
      t: "`$INTEGER`"
    }
