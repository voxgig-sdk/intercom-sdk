ng\"},\"conversation_id\":{\"description\":\"The id of the conversation associated with the call, if any.\",\"example\":\"456\",\"nullable\":true,\"type\":\"string\"},\"created_at\":{\"oneOf\":[{\"description\":\"A date and time following the ISO8601 notation.\",\"format\":\"date-time\",\"title\":\"string\",\"type\":\"string\"},{\"description\":\"A date and time as UNIX timestamp notation.\",\"title\":\"integer\",\"type\":\"integer\"}]},\"direction\":{\"description\":\"The direction of the call.\",\"example\":\"outbound\",\"type\":\"string\"},\"ended_at\":{\"oneOf\":[{\"description\":\"A date and time following the ISO8601 notation.\",\"format\":\"date-time\",\"title\":\"string\",\"type\":\"string\"},{\"description\":\"A date and time as UNIX timestamp notation.\",\"title\":\"integer\",\"type\":\"integer\"}]},\"ended_reason\":{\"description\":\"The reason for the call end, if applicable.\",\"example\":\"completed\",\"nullable\":true,\"type\":\"string\"},\"fin_recording_url\":{\"description\":\"API URL to the AI Agent (Fin) call recording if available.\",\"format\":\"uri\",\"nullable\":true,\"type\":\"string\"},\"fin_transcription_url\":{\"description\":\"API URL to the AI Agent (Fin) call transcript if available.\",\"format\":\"uri\",\"nullable\":true,\"type\":\"string\"},\"id\":{\"description\":\"The id of the call.\",\"example\":\"123\",\"type\":\"string\"},\"initiated_at\":{\"oneOf\":[{\"description\":\"A date and time following the ISO8601 notation.\",\"format\":\"date-time\",\"title\":\"string\",\"type\":\"string\"},{\"description\":\"A date and time as UNIX timestamp notation.\",\"title\":\"integer\",\"type\":\"integer\"}]},\"phone\":{\"description\":\"The phone number involved in the call, in E.164 format.\",\"example\":\"+15551234567\",\"nullable\":true,\"type\":\"string\"},\"recording_url\":{\"description\":\"API URL to download or redirect to the call recording if available.\",\"example\":\"https://api.intercom.io/calls/123/recording\",\"format\":\"uri\",\