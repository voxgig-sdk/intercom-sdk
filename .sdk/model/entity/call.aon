          contract: {
            id: "POST /calls/search"
            json: "{\"operationId\":\"listCallsWithTranscripts\",\"parameters\":[{\"in\":\"header\",\"name\":\"Intercom-Version\",\"schema\":{\"default\":\"2.16\",\"description\":\"Intercom API version.</br>By default, it's equal to the version set in the app package.\",\"enum\":[\"1.0\",\"1.1\",\"1.2\",\"1.3\",\"1.4\",\"2.0\",\"2.1\",\"2.2\",\"2.3\",\"2.4\",\"2.5\",\"2.6\",\"2.7\",\"2.8\",\"2.9\",\"2.10\",\"2.11\",\"2.12\",\"2.13\",\"2.14\",\"2.15\",\"2.16\"],\"example\":\"2.16\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"example\":{\"value\":{\"conversation_ids\":[\"64619700005694\",\"64619700005695\"]}}},\"schema\":{\"properties\":{\"conversation_ids\":{\"description\":\"A list of conversation ids to fetch calls for. Maximum 20.\",\"items\":{\"type\":\"string\"},\"maxItems\":20,\"minItems\":1,\"type\":\"array\"}},\"required\":[\"conversation_ids\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"successful\":{\"value\":{\"data\":[{\"conversation_id\":\"64619700005694\",\"id\":\"123\",\"transcript\":[{}],\"transcript_status\":\"completed\",\"type\":\"call\"}],\"type\":\"list\"}}},\"schema\":{\"properties\":{\"data\":{\"items\":{\"allOf\":[{\"description\":\"Represents a phone call in Intercom\",\"properties\":{\"admin_id\":{\"description\":\"The id of the admin associated with the call, if any.\",\"example\":\"789\",\"nullable\":true,\"type\":\"string\"},\"answered_at\":{\"oneOf\":[{\"description\":\"A date and time following the ISO8601 notation.\",\"format\":\"date-time\",\"title\":\"string\",\"type\":\"string\"},{\"description\":\"A date and time as UNIX timestamp notation.\",\"title\":\"integer\",\"type\":\"integer\"}]},\"call_type\":{\"description\":\"The type of call.\",\"example\":\"phone\",\"type\":\"string\"},\"contact_id\":{\"description\":\"The id of the contact associated with the call, if any.\",\"example\":\"6762f0dd1bb69f9f2193bb83\",\"nullable\":true,\"type\":\"string\"},\"conversation_id\":{\"description\":\"The id of the conversation associated with the call, if any.\",\"example\":\"456\",\"nullable\":true,\"type\":\"string\"},\"created_at\":{\"oneOf\":[{\"description\":\"A date and time following the ISO8601 notation.\",\"format\":\"date-time\",\"title\":\"string\",\"type\":\"string\"},{\"description\":\"A date and time as UNIX timestamp notation.\",\"title\":\"integer\",\"type\":\"integer\"}]},\"direction\":{\"description\":\"The direction of the call.\",\"example\":\"outbound\",\"type\":\"string\"},\"ended_at\":{\"oneOf\":[{\"description\":\"A date and time following the ISO8601 notation.\",\"format\":\"date-time\",\"title\":\"string\",\"type\":\"string\"},{\"description\":\"A date and time as UNIX timestamp notation.\",\"title\":\"integer\",\"type\":\"integer\"}]},\"ended_reason\":{\"description\":\"The reason for the call end, if applicable.\",\"example\":\"completed\",\"nullable\":true,\"type\":\"string\"},\"fin_recording_url\":{\"description\":\"API URL to the AI Agent (Fin) call recording if available.\",\"format\":\"uri\",\"nullable\":true,\"type\":\"string\"},\"fin_transcription_url\":{\"description\":\"API URL to the AI Agent (Fin) call transcript if available.\",\"format\":\"uri\",\"nullable\":true,\"type\":\"string\"},\"id\":{\"description\":\"The id of the call.\",\"example\":\"123\",\"type\":\"string\"},\"initiated_at\":{\"oneOf\":[{\"description\":\"A date and time following the ISO8601 notation.\",\"format\":\"date-time\",\"title\":\"string\",\"type\":\"string\"},{\"description\":\"A date and time as UNIX timestamp notation.\",\"title\":\"integer\",\"type\":\"integer\"}]},\"phone\":{\"description\":\"The phone number involved in the call, in E.164 format.\",\"example\":\"+15551234567\",\"nullable\":true,\"type\":\"string\"},\"recording_url\":{\"description\":\"API URL to download or redirect to the call recording if available.\",\"example\":\"https://api.intercom.io/calls/123/recording\",\"format\":\"uri\",\"nullable\":true,\"type\":\"string\"},\"state\":{\"description\":\"The current state of the call.\",\"example\":\"completed\",\"type\":\"string\"},\"transcription_url\":{\"description\":\"API URL to download or redirect to the call transcript if available.\",\"example\":\"https://api.intercom.io/calls/123/transcript\",\"format\":\"uri\",\"nullable\":true,\"type\":\"string\"},\"type\":{\"description\":\"String representing the object's type. Always has the value `call`.\",\"example\":\"call\",\"type\":\"string\"},\"updated_at\":{\"oneOf\":[{\"description\":\"A date and time following the ISO8601 notation.\",\"format\":\"date-time\",\"title\":\"string\",\"type\":\"string\"},{\"description\":\"A date and time as UNIX timestamp notation.\",\"title\":\"integer\",\"type\":\"integer\"}]}},\"title\":\"Call\",\"type\":\"object\"},{\"properties\":{\"transcript\":{\"description\":\"The call transcript if available, otherwise an empty array.\",\"items\":{\"additionalProperties\":true,\"type\":\"object\"},\"type\":\"array\"},\"transcript_status\":{\"description\":\"The status of the transcript if available.\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"}]},\"type\":\"array\"},\"type\":{\"example\":\"list\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"successful\"},\"400\":{\"content\":{\"application/json\":{\"examples\":{\"too_many_ids\":{\"value\":{\"errors\":[{\"code\":\"conversation_id_limit_exceeded\",\"message\":\"A list of up to 20 conversation IDs is required\"}],\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"errors\":{\"description\":\"An array of one or more error objects\",\"items\":{\"properties\":{\"code\":{\"description\":\"A string indicating the kind of error, used to further qualify the HTTP response code\",\"example\":\"unauthorized\",\"type\":\"string\"},\"field\":{\"description\":\"Optional. Used to identify a particular field or query parameter that was in error.\",\"example\":\"email\",\"nullable\":true,\"type\":\"string\"},\"message\":{\"description\":\"Optional. Human readable description of the error.\",\"example\":\"Access Token Invalid\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"code\"]},\"type\":\"array\"},\"request_id\":{\"description\":\"\",\"example\":\"f93ecfa8-d08a-4325-8694-89aeb89c8f85\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type is error.list\",\"example\":\"error.list\",\"type\":\"string\"}},\"required\":[\"type\",\"errors\"],\"title\":\"Error\",\"type\":\"object\"}}},\"description\":\"Bad Request\"},\"401\":{\"content\":{\"application/json\":{\"examples\":{\"Unauthorized\":{\"value\":{\"errors\":[{\"code\":\"unauthorized\",\"message\":\"Access Token Invalid\"}],\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"$ref\":\"#/responses/400/content/application~1json/schema/properties\"},\"required\":{\"$ref\":\"#/responses/400/content/application~1json/schema/required\"},\"title\":\"Error\",\"type\":\"object\"}}},\"description\":\"Unauthorized\"}},\"security\":[{\"bearerAuth\":[]}],\"securitySchemes\":{\"bearerAuth\":{\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"definition\"}"
