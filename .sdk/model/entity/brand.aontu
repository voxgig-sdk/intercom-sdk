# Entity: brand

main: kit: entity: brand: {

  alias: field: {}

  fields: {
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      sh: "Unix timestamp of brand creation"
      t: "`$INTEGER`"
    }
    default_address_settings_id: {
      h: "Default Address Settings Id"
      n: "default_address_settings_id"
      r: false
      sh: "Default email settings ID for this brand"
      t: "`$STRING`"
    }
    help_center_id: {
      h: "Help Center Id"
      n: "help_center_id"
      r: false
      sh: "Associated help center identifier"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique brand identifier."
      t: "`$STRING`"
    }
    is_default: {
      h: "Is Default"
      n: "is_default"
      r: false
      sh: "Whether this is the workspace's default brand"
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Display name of the brand"
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "The type of object"
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "Unix timestamp of last modification"
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "brand"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /brands"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                ex: "2.16"
                k: "header"
                n: "intercom_version"
                or: "intercom_version"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/brands"
          q: {
            exist: [
              "intercom_version"
            ]
          }
          s: [
            {
              lit: "brands"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /brands/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                ex: "2.16"
                k: "header"
                n: "intercom_version"
                or: "intercom_version"
                r: false
                t: "`$STRING`"
              }
            ]
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/brands/{id}"
          q: {
            exist: [
              "id"
              "intercom_version"
            ]
          }
          s: [
            {
              lit: "brands"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
