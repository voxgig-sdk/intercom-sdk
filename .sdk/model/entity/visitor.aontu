  id: {
    field: "id"
    name: "id"
  }

  name: "visitor"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /visitors"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                ex: "2.16"
                k: "header"
                n: "intercom_version"
                or: "intercom_version"
                r: false
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "user_id"
                or: "user_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/visitors"
          q: {
            exist: [
              "intercom_version"
              "user_id"
            ]
          }
          s: [
            {
              lit: "visitors"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PUT /visitors"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                ex: "2.16"
                k: "header"
                n: "intercom_version"
                or: "intercom_version"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "PUT"
          o: "/visitors"
          q: {
            exist: [
              "intercom_version"
            ]
          }
          s: [
            {
              lit: "visitors"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
