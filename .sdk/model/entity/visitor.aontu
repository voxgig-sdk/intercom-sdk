    }
    updated_at: {
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "The last time the Visitor was updated."
      t: "`$INTEGER`"
    }
    user_id: {
      h: "User Id"
      n: "user_id"
      r: false
      sh: "Automatically generated identifier for the Visitor."
      t: "`$STRING`"
    }
    utm_campaign: {
      h: "Utm Campaign"
      n: "utm_campaign"
      r: false
      sh: "The utm_campaign of the visitor."
      t: "`$STRING`"
    }
    utm_content: {
      h: "Utm Content"
      n: "utm_content"
      r: false
      sh: "The utm_content of the visitor."
      t: "`$STRING`"
    }
    utm_medium: {
      h: "Utm Medium"
      n: "utm_medium"
      r: false
      sh: "The utm_medium of the visitor."
      t: "`$STRING`"
    }
    utm_source: {
      h: "Utm Source"
      n: "utm_source"
