# Entity: content_import_source

main: kit: entity: content_import_source: {

  alias: field: {}

  fields: {
    apply_audience_to_existing_content: {
      h: "Apply Audience To Existing Content"
      n: "apply_audience_to_existing_content"
      r: false
      sh: "When true, the audience will be applied to all existing external pages belonging to this content import source."
      t: "`$BOOLEAN`"
    }
    audience_ids: {
      h: "Audience Ids"
      n: "audience_ids"
      r: false
      sh: "The unique identifiers for the audiences associated with this content import source."
      t: "`$ARRAY`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "The time when the content import source was created."
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The unique identifier for the content import source which is given by Intercom."
      t: "`$INTEGER`"
    }
    last_synced_at: {
      fo: "date-time"
      h: "Last Synced At"
      n: "last_synced_at"
      r: true
      sh: "The time when the content import source was last synced."
      t: "`$INTEGER`"
    }
    status: {
      h: "Status"
      n: "status"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The status of the content import source."
      t: "`$STRING`"
    }
    sync_behavior: {
      h: "Sync Behavior"
      n: "sync_behavior"
      r: true
      sh: "If you intend to create or update External Pages via the API, this should be set to `api`."
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "Always external_page"
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "The time when the content import source was last updated."
      t: "`$INTEGER`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The URL of the root of the external source."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "content_import_source"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
