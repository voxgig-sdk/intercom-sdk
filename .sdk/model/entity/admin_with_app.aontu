    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of the admin."
      t: "`$STRING`"
    }
    team_ids: {
      h: "Team Ids"
      n: "team_ids"
      r: false
      sh: "This is a list of ids of the teams that this admin is part of."
      t: "`$ARRAY`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "String representing the object's type."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "admin_with_app"
  op: {
    list: {
