# Entity: reporting_data

main: kit: entity: reporting_data: {

  alias: field: {}

  fields: {
    download_expires_at: {
      h: "Download Expires At"
      n: "download_expires_at"
      r: false
      t: "`$STRING`"
    }
    download_url: {
      h: "Download Url"
      n: "download_url"
      r: false
      t: "`$STRING`"
    }
    job_identifier: {
      h: "Job Identifier"
      n: "job_identifier"
