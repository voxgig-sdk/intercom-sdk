    }
    intercom_conversation_id: {
      h: "Intercom Conversation Id"
      n: "intercom_conversation_id"
      r: false
      sh: "The Intercom conversation identifier, if a conversation has been created"
      t: "`$STRING`"
    }
    phone_number: {
      h: "Phone Number"
      n: "phone_number"
      r: true
      sh: "Phone number in E.164 format for the call"
