        branches: 2
        count: 1
        depth: 1
      }
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The unique identifier for the newsfeed which is given by Intercom."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of the newsfeed."
      t: "`$STRING`"
    }
    pages: {
      h: "Pages"
      n: "pages"
