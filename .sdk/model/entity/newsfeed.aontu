    }
    total_count: {
      h: "Total Count"
      n: "total_count"
      r: false
      sh: "A count of the total number of objects."
      t: "`$INTEGER`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "The type of object."
