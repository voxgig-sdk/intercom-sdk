  }

  id: {
    field: "id"
    name: "id"
  }

  name: "newsfeed"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /news/newsfeeds"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                ex: "2.16"
                k: "header"
                n: "intercom_version"
                or: "intercom_version"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/news/newsfeeds"
          q: {
            exist: [
              "intercom_version"
            ]
          }
          s: [
            {
              lit: "news"
            }
            {
              lit: "newsfeeds"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /news/newsfeeds/{newsfeed_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                ex: "2.16"
                k: "header"
                n: "intercom_version"
                or: "intercom_version"
                r: false
                t: "`$STRING`"
              }
            ]
            params: [
              {
                ex: "123"
                k: "param"
                n: "id"
                or: "newsfeed_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/news/newsfeeds/{newsfeed_id}"
          q: {
            exist: [
              "id"
              "intercom_version"
            ]
          }
          r: {
            param: {
              newsfeed_id: "id"
            }
          }
          s: [
            {
              lit: "news"
            }
            {
              lit: "newsfeeds"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



