          contract: {
            id: "GET /data_connectors"
            json: "{\"operationId\":\"listDataConnectors\",\"parameters\":[{\"in\":\"header\",\"name\":\"Intercom-Version\",\"schema\":{\"default\":\"2.16\",\"description\":\"Intercom API version.</br>By default, it's equal to the version set in the app package.\",\"enum\":[\"1.0\",\"1.1\",\"1.2\",\"1.3\",\"1.4\",\"2.0\",\"2.1\",\"2.2\",\"2.3\",\"2.4\",\"2.5\",\"2.6\",\"2.7\",\"2.8\",\"2.9\",\"2.10\",\"2.11\",\"2.12\",\"2.13\",\"2.14\",\"2.15\",\"2.16\"],\"example\":\"2.16\",\"type\":\"string\"}},{\"description\":\"The number of results to return per page. Defaults to 20, minimum 1, maximum 50.\",\"in\":\"query\",\"name\":\"per_page\",\"required\":false,\"schema\":{\"default\":20,\"maximum\":50,\"minimum\":1,\"type\":\"integer\"}},{\"description\":\"The cursor value from `pages.next.starting_after` in a previous response. Used to paginate through results.\",\"in\":\"query\",\"name\":\"starting_after\",\"required\":false,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"successful\":{\"value\":{\"data\":[{\"created_at\":\"2025-11-15T09:30:00Z\",\"created_by_admin_id\":\"128\",\"description\":\"Fetches order status from external fulfillment API\",\"direct_fin_usage\":false,\"execution_results_url\":\"/data_connectors/12345/execution_results\",\"http_method\":\"post\",\"id\":\"12345\",\"name\":\"Order Status Service\",\"state\":\"live\",\"type\":\"data_connector\",\"updated_at\":\"2026-01-20T14:22:15Z\",\"updated_by_admin_id\":\"128\"}],\"pages\":{\"next\":{\"starting_after\":\"WzE3MDc1OTQ3MTUuMCwxMjM0NV0=\"},\"per_page\":20,\"type\":\"pages\"},\"type\":\"list\"}}},\"schema\":{\"description\":\"A paginated list of data connectors.\",\"properties\":{\"data\":{\"description\":\"An array of data connector objects.\",\"items\":{\"description\":\"A data connector allows you to make HTTP requests to external APIs from Intercom workflows and AI agents.\\n\",\"properties\":{\"created_at\":{\"description\":\"The time the data connector was created.\",\"example\":\"2025-11-15T09:30:00Z\",\"format\":\"date-time\",\"type\":\"string\"},\"created_by_admin_id\":{\"description\":\"The ID of the admin who created this data connector.\",\"example\":\"12345\",\"type\":\"string\"},\"description\":{\"description\":\"A description of what this data connector does.\",\"example\":\"Fetches order status from external fulfillment API\",\"nullable\":true,\"type\":\"string\"},\"direct_fin_usage\":{\"description\":\"Whether this data connector is assigned to Fin for direct usage.\",\"example\":false,\"type\":\"boolean\"},\"execution_results_url\":{\"description\":\"The URL path to fetch execution results for this connector.\",\"example\":\"/data_connectors/12345/execution_results\",\"type\":\"string\"},\"http_method\":{\"description\":\"The HTTP method used by the data connector.\",\"enum\":[\"get\",\"post\",\"put\",\"delete\",\"patch\"],\"example\":\"post\",\"type\":\"string\"},\"id\":{\"description\":\"The unique identifier for the data connector.\",\"example\":\"12345\",\"type\":\"string\"},\"name\":{\"description\":\"The name of the data connector.\",\"example\":\"Order Status Service\",\"type\":\"string\"},\"state\":{\"description\":\"The current state of the data connector.\",\"enum\":[\"draft\",\"live\"],\"example\":\"live\",\"type\":\"string\"},\"type\":{\"description\":\"The type of object - `data_connector`.\",\"enum\":[\"data_connector\"],\"example\":\"data_connector\",\"type\":\"string\"},\"updated_at\":{\"description\":\"The time the data connector was last updated.\",\"example\":\"2026-01-20T14:22:15Z\",\"format\":\"date-time\",\"type\":\"string\"},\"updated_by_admin_id\":{\"description\":\"The ID of the admin who last updated this data connector.\",\"example\":\"12345\",\"type\":\"string\"}},\"title\":\"Data Connector\",\"type\":\"object\"},\"type\":\"array\"},\"pages\":{\"description\":\"Pagination information.\",\"properties\":{\"next\":{\"description\":\"Cursor for the next page of results.\",\"nullable\":true,\"properties\":{\"starting_after\":{\"description\":\"The cursor value to use for the next page.\",\"example\":\"WzE3MDc1OTQ3MTUuMCwxMjM0NV0=\",\"type\":\"string\"}},\"type\":\"object\"},\"per_page\":{\"description\":\"The number of results per page.\",\"example\":20,\"type\":\"integer\"},\"type\":{\"enum\":[\"pages\"],\"example\":\"pages\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":{\"description\":\"The type of object - `list`.\",\"enum\":[\"list\"],\"example\":\"list\",\"type\":\"string\"}},\"title\":\"Data Connector List\",\"type\":\"object\"}}},\"description\":\"successful\"},\"400\":{\"content\":{\"application/json\":{\"examples\":{\"Invalid cursor\":{\"value\":{\"errors\":[{\"code\":\"client_error\",\"message\":\"Invalid starting_after param. Please try again using a starting_after value from a paginated response\"}],\"request_id\":\"test-uuid-replacement\",\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"errors\":{\"description\":\"An array of one or more error objects\",\"items\":{\"properties\":{\"code\":{\"description\":\"A string indicating the kind of error, used to further qualify the HTTP response code\",\"example\":\"unauthorized\",\"type\":\"string\"},\"field\":{\"description\":\"Optional. Used to identify a particular field or query parameter that was in error.\",\"example\":\"email\",\"nullable\":true,\"type\":\"string\"},\"message\":{\"description\":\"Optional. Human readable description of the error.\",\"example\":\"Access Token Invalid\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"code\"]},\"type\":\"array\"},\"request_id\":{\"description\":\"\",\"example\":\"f93ecfa8-d08a-4325-8694-89aeb89c8f85\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type is error.list\",\"example\":\"error.list\",\"type\":\"string\"}},\"required\":[\"type\",\"errors\"],\"title\":\"Error\",\"type\":\"object\"}}},\"description\":\"Bad Request\"},\"401\":{\"content\":{\"application/json\":{\"examples\":{\"Unauthorized\":{\"value\":{\"errors\":[{\"code\":\"unauthorized\",\"message\":\"Access Token Invalid\"}],\"request_id\":\"test-uuid-replacement\",\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"$ref\":\"#/responses/400/content/application~1json/schema/properties\"},\"required\":{\"$ref\":\"#/responses/400/content/application~1json/schema/required\"},\"title\":\"Error\",\"type\":\"object\"}}},\"description\":\"Unauthorized\"}},\"security\":[{\"bearerAuth\":[]}],\"securitySchemes\":{\"bearerAuth\":{\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"definition\"}"
