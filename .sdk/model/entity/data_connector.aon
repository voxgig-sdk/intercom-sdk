          contract: {
            id: "POST /data_connectors"
            json: "{\"operationId\":\"createDataConnector\",\"parameters\":[{\"in\":\"header\",\"name\":\"Intercom-Version\",\"schema\":{\"default\":\"2.16\",\"description\":\"Intercom API version.</br>By default, it's equal to the version set in the app package.\",\"enum\":[\"1.0\",\"1.1\",\"1.2\",\"1.3\",\"1.4\",\"2.0\",\"2.1\",\"2.2\",\"2.3\",\"2.4\",\"2.5\",\"2.6\",\"2.7\",\"2.8\",\"2.9\",\"2.10\",\"2.11\",\"2.12\",\"2.13\",\"2.14\",\"2.15\",\"2.16\"],\"example\":\"2.16\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"data_connector_created\":{\"summary\":\"Data connector created\",\"value\":{\"audiences\":[\"leads\",\"visitors\"],\"bypass_authentication\":false,\"customer_authentication\":true,\"data_inputs\":[{\"default_value\":\"\",\"description\":\"The order ID to look up\",\"name\":\"order_id\",\"required\":true,\"type\":\"string\"}],\"description\":\"Looks up order status from an external service\",\"direct_fin_usage\":true,\"headers\":[{\"name\":\"Content-Type\",\"value\":\"application/json\"}],\"http_method\":\"get\",\"name\":\"Get Order Status\",\"url\":\"https://api.example.com/orders/{{order_id}}/status\",\"validate_missing_attributes\":true}},\"minimal\":{\"summary\":\"Minimal - name only\",\"value\":{\"name\":\"My Connector\"}},\"with_mock_response\":{\"summary\":\"With mock response\",\"value\":{\"mock_response\":{\"order\":{\"id\":12345,\"status\":\"shipped\"}},\"name\":\"Order Lookup\"}}},\"schema\":{\"description\":\"You can create a data connector by providing the required parameters.\",\"properties\":{\"audiences\":{\"description\":\"The user types this connector is available for.\",\"example\":[\"leads\",\"visitors\"],\"items\":{\"enum\":[\"leads\",\"users\",\"visitors\"],\"type\":\"string\"},\"type\":\"array\"},\"body\":{\"description\":\"The request body template. Supports template variables.\",\"type\":\"string\"},\"bypass_authentication\":{\"description\":\"Whether authentication is bypassed entirely (public endpoint). Defaults to false.\",\"example\":false,\"type\":\"boolean\"},\"customer_authentication\":{\"description\":\"Whether the connector requires customer authentication before executing. Defaults to false.\",\"example\":false,\"type\":\"boolean\"},\"data_inputs\":{\"description\":\"Input parameters accepted by the connector.\",\"items\":{\"properties\":{\"default_value\":{\"description\":\"The default value for the parameter. Defaults to an empty string if omitted.\",\"type\":\"string\"},\"description\":{\"description\":\"A description of the parameter.\",\"example\":\"The order ID to look up\",\"type\":\"string\"},\"name\":{\"description\":\"The parameter name.\",\"example\":\"order_id\",\"type\":\"string\"},\"required\":{\"description\":\"Whether the parameter is required.\",\"example\":true,\"type\":\"boolean\"},\"type\":{\"description\":\"The parameter type.\",\"enum\":[\"string\",\"integer\",\"decimal\",\"boolean\"],\"example\":\"string\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"description\":{\"description\":\"A description of what this data connector does.\",\"example\":\"Looks up order status from an external service\",\"type\":\"string\"},\"direct_fin_usage\":{\"description\":\"Whether the connector is used directly by Fin (true) or only in workflows (false). Defaults to false.\",\"example\":false,\"type\":\"boolean\"},\"headers\":{\"description\":\"HTTP headers to include in the request.\",\"items\":{\"properties\":{\"name\":{\"description\":\"The header name.\",\"example\":\"Content-Type\",\"type\":\"string\"},\"value\":{\"description\":\"The header value. Supports template variables.\",\"example\":\"application/json\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"http_method\":{\"description\":\"The HTTP method used when calling the external API.\",\"enum\":[\"get\",\"post\",\"put\",\"delete\",\"patch\"],\"example\":\"get\",\"type\":\"string\"},\"mock_response\":{\"description\":\"A sample JSON response from the external API. Auto-generates `response_fields` and sets `configuration_response_type` to `mock_response_type`.\",\"example\":{\"order\":{\"id\":12345,\"status\":\"shipped\"}},\"type\":\"object\"},\"name\":{\"description\":\"The name of the data connector.\",\"example\":\"Get Order Status\",\"type\":\"string\"},\"token_ids\":{\"description\":\"IDs of authentication tokens to attach to this data connector.\",\"example\":[\"1234\",\"5678\"],\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"url\":{\"description\":\"The URL of the external API endpoint. Supports template variables like `{{order_id}}`.\",\"example\":\"https://api.example.com/orders/{{order_id}}/status\",\"type\":\"string\"},\"validate_missing_attributes\":{\"description\":\"Whether to validate that all required data inputs have values before executing.\",\"example\":false,\"type\":\"boolean\"}},\"required\":[\"name\"],\"title\":\"Create Data Connector Request\",\"type\":\"object\"}}}},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"examples\":{\"Data connector created\":{\"value\":{\"audiences\":[\"leads\",\"visitors\"],\"bypass_authentication\":false,\"client_function_timeout_ms\":30000,\"configuration_response_type\":\"test_response_type\",\"created_at\":\"2026-03-19T11:27:36Z\",\"created_by_admin_id\":\"128\",\"customer_authentication\":true,\"data_inputs\":[{\"default_value\":\"\",\"description\":\"The order ID to look up\",\"name\":\"order_id\",\"required\":true,\"type\":\"string\"}],\"data_transformation_type\":\"full_access\",\"description\":\"Looks up order status from an external service\",\"direct_fin_usage\":true,\"execution_results_url\":\"/data_connectors/125/execution_results\",\"execution_type\":\"server_side\",\"http_method\":\"get\",\"id\":\"125\",\"name\":\"Get Order Status\",\"object_mappings\":[],\"response_fields\":[],\"state\":\"draft\",\"token_ids\":[],\"type\":\"data_connector\",\"updated_at\":\"2026-03-19T11:27:36Z\",\"updated_by_admin_id\":\"128\",\"validate_missing_attributes\":true}}},\"schema\":{\"description\":\"Full detail view of a data connector, returned by `GET /data_connectors/{id}`.\\nIncludes configuration, data inputs, response fields, and object mappings.\\n\",\"properties\":{\"audiences\":{\"description\":\"The audience types this connector targets.\",\"example\":[\"users\",\"leads\"],\"items\":{\"enum\":[\"users\",\"leads\",\"visitors\"],\"type\":\"string\"},\"type\":\"array\"},\"body\":{\"description\":\"The request body template. Supports template variables.\",\"example\":\"{\\\"text\\\": \\\"{{message}}\\\"}\",\"type\":\"string\"},\"bypass_authentication\":{\"description\":\"Whether authentication is bypassed for this connector.\",\"example\":false,\"type\":\"boolean\"},\"client_function_name\":{\"description\":\"The name of the client-side function, if applicable.\",\"nullable\":true,\"type\":\"string\"},\"client_function_timeout_ms\":{\"description\":\"Timeout in milliseconds for the client function, if applicable.\",\"nullable\":true,\"type\":\"integer\"},\"configuration_response_type\":{\"description\":\"The expected response format from the connector.\",\"enum\":[\"test_response_type\",\"mock_response_type\"],\"example\":\"test_response_type\",\"nullable\":true,\"type\":\"string\"},\"created_at\":{\"description\":\"The time the data connector was created.\",\"example\":\"2025-11-15T09:30:00Z\",\"format\":\"date-time\",\"type\":\"string\"},\"created_by_admin_id\":{\"description\":\"The ID of the admin who created this connector.\",\"example\":\"456\",\"nullable\":true,\"type\":\"string\"},\"customer_authentication\":{\"description\":\"Whether OTP authentication is enabled for this connector.\",\"example\":false,\"type\":\"boolean\"},\"data_inputs\":{\"description\":\"The input parameters accepted by this data connector.\",\"items\":{\"properties\":{\"default_value\":{\"description\":\"The default value for this input, if any.\",\"type\":\"string\"},\"description\":{\"description\":\"A description of the input parameter.\",\"nullable\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the input parameter.\",\"example\":\"conversation_id\",\"type\":\"string\"},\"required\":{\"description\":\"Whether this input is required.\",\"example\":true,\"type\":\"boolean\"},\"type\":{\"description\":\"The data type of the input.\",\"enum\":[\"string\",\"integer\",\"decimal\",\"boolean\"],\"example\":\"string\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"data_transformation_type\":{\"description\":\"The type of data transformation applied to the response.\",\"enum\":[\"full_access\",\"redacted_access\",\"code_block_transformation\"],\"nullable\":true,\"type\":\"string\"},\"description\":{\"description\":\"A description of what this data connector does.\",\"example\":\"Fetches order status from external fulfillment API\",\"nullable\":true,\"type\":\"string\"},\"direct_fin_usage\":{\"description\":\"Whether this connector is used directly by Fin.\",\"example\":false,\"type\":\"boolean\"},\"execution_results_url\":{\"description\":\"The URL path to fetch execution results for this connector.\",\"example\":\"/data_connectors/12345/execution_results\",\"type\":\"string\"},\"execution_type\":{\"description\":\"How the connector executes.\",\"enum\":[\"server_side\",\"client_side\"],\"example\":\"server_side\",\"nullable\":true,\"type\":\"string\"},\"headers\":{\"description\":\"HTTP headers for the request. Header values are always redacted as `\\\"****\\\"` in responses.\",\"example\":[{\"name\":\"Authorization\",\"value\":\"****\"}],\"items\":{\"properties\":{\"name\":{\"description\":\"The header name.\",\"example\":\"Authorization\",\"type\":\"string\"},\"value\":{\"description\":\"Always `\\\"****\\\"` in responses.\",\"example\":\"****\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"http_method\":{\"description\":\"The HTTP method used by the data connector.\",\"enum\":[\"get\",\"post\",\"put\",\"delete\",\"patch\"],\"example\":\"post\",\"type\":\"string\"},\"id\":{\"description\":\"The unique identifier for the data connector.\",\"example\":\"12345\",\"type\":\"string\"},\"name\":{\"description\":\"The name of the data connector.\",\"example\":\"Order Status Service\",\"type\":\"string\"},\"object_mappings\":{\"description\":\"Mappings from connector response objects to Intercom objects.\",\"items\":{\"properties\":{\"attribute_mappings\":{\"items\":{\"properties\":{\"intercom_attribute_identifier\":{\"type\":\"string\"},\"mapping_type\":{\"enum\":[\"primitive_mapping\",\"context_mapping\"],\"type\":\"string\"},\"response_attribute_path\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"intercom_object_type\":{\"enum\":[\"conversation\",\"user\"],\"type\":\"string\"},\"reference_mappings\":{\"items\":{\"properties\":{\"intercom_attribute_identifier\":{\"type\":\"string\"},\"intercom_object_type\":{\"enum\":[\"conversation\",\"user\"],\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"response_object_path\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"response_fields\":{\"description\":\"The fields returned in the connector response.\",\"items\":{\"properties\":{\"example_value\":{\"description\":\"An example value for this field.\",\"example\":\"ok\",\"nullable\":true},\"path\":{\"description\":\"The JSON path of the response field.\",\"example\":\"status\",\"type\":\"string\"},\"redacted\":{\"description\":\"Whether this field is redacted in logs.\",\"example\":false,\"type\":\"boolean\"},\"type\":{\"description\":\"The data type of the response field.\",\"enum\":[\"unknown\",\"string\",\"integer\",\"decimal\",\"datetime\",\"boolean\"],\"example\":\"string\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"state\":{\"description\":\"The current state of the data connector.\",\"enum\":[\"draft\",\"live\"],\"example\":\"live\",\"type\":\"string\"},\"token_ids\":{\"description\":\"IDs of authentication tokens associated with this connector.\",\"example\":[],\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"type\":{\"description\":\"The type of object - `data_connector`.\",\"enum\":[\"data_connector\"],\"example\":\"data_connector\",\"type\":\"string\"},\"updated_at\":{\"description\":\"The time the data connector was last updated.\",\"example\":\"2026-01-20T14:22:15Z\",\"format\":\"date-time\",\"type\":\"string\"},\"updated_by_admin_id\":{\"description\":\"The ID of the admin who last updated this connector.\",\"example\":\"456\",\"nullable\":true,\"type\":\"string\"},\"url\":{\"description\":\"The URL of the external API endpoint. Supports template variables like `{{order_id}}`.\",\"example\":\"https://api.example.com/orders/{{order_id}}/status\",\"nullable\":true,\"type\":\"string\"},\"validate_missing_attributes\":{\"description\":\"Whether to validate missing attributes before execution.\",\"nullable\":true,\"type\":\"boolean\"}},\"title\":\"Data Connector (Detail)\",\"type\":\"object\"}}},\"description\":\"Data connector created\"},\"401\":{\"content\":{\"application/json\":{\"examples\":{\"Unauthorized\":{\"value\":{\"errors\":[{\"code\":\"unauthorized\",\"message\":\"Access Token Invalid\"}],\"request_id\":\"test-uuid-replacement\",\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"errors\":{\"description\":\"An array of one or more error objects\",\"items\":{\"properties\":{\"code\":{\"description\":\"A string indicating the kind of error, used to further qualify the HTTP response code\",\"example\":\"unauthorized\",\"type\":\"string\"},\"field\":{\"description\":\"Optional. Used to identify a particular field or query parameter that was in error.\",\"example\":\"email\",\"nullable\":true,\"type\":\"string\"},\"message\":{\"description\":\"Optional. Human readable description of the error.\",\"example\":\"Access Token Invalid\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"code\"]},\"type\":\"array\"},\"request_id\":{\"description\":\"\",\"example\":\"f93ecfa8-d08a-4325-8694-89aeb89c8f85\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type is error.list\",\"example\":\"error.list\",\"type\":\"string\"}},\"required\":[\"type\",\"errors\"],\"title\":\"Error\",\"type\":\"object\"}}},\"description\":\"Unauthorized\"},\"422\":{\"content\":{\"application/json\":{\"examples\":{\"Invalid audiences\":{\"value\":{\"errors\":[{\"code\":\"parameter_invalid\",\"message\":\"Invalid audiences. Must be a subset of: leads, users, visitors\"}],\"request_id\":\"c5b56f3d-8b9e-5g4f-0d2b-3e6f9g8b7c4d\",\"type\":\"error.list\"}},\"Missing name\":{\"value\":{\"errors\":[{\"code\":\"parameter_not_found\",\"message\":\"Name is required\"}],\"request_id\":\"b4a45e2c-7a8d-4f3e-9c1a-2d5e8f7a6b3c\",\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"$ref\":\"#/responses/401/content/application~1json/schema/properties\"},\"required\":{\"$ref\":\"#/responses/401/content/application~1json/schema/required\"},\"title\":\"Error\",\"type\":\"object\"}}},\"description\":\"Invalid parameter\"}},\"security\":[{\"bearerAuth\":[]}],\"securitySchemes\":{\"bearerAuth\":{\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"definition\"}"
