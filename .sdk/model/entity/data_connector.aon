    update: {
      name: "update"
      points: [
        {
          args: {
            header: [
              {
                example: "2.16"
                kind: "header"
                name: "intercom_version"
                orig: "intercom_version"
                reqd: false
                type: "`$STRING`"
              }
            ]
            params: [
