            ]
          }
          r: {
            param: {
              call_id: "id"
            }
          }
          s: [
            {
              lit: "calls"
            }
            {
              var: "id"
            }
            {
              lit: "transcript"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /fin_voice/phone_number/{phone_number}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "phone_number"
                or: "phone_number"
                r: true
