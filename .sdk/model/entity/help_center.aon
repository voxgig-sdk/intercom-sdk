          contract: {
            id: "POST /help_center/help_centers/{help_center_id}/redirects"
            json: "{\"operationId\":\"createHelpCenterRedirect\",\"parameters\":[{\"description\":\"The unique identifier for the help center.\",\"example\":\"123\",\"in\":\"path\",\"name\":\"help_center_id\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"in\":\"header\",\"name\":\"Intercom-Version\",\"schema\":{\"default\":\"2.16\",\"description\":\"Intercom API version.</br>By default, it's equal to the version set in the app package.\",\"enum\":[\"1.0\",\"1.1\",\"1.2\",\"1.3\",\"1.4\",\"2.0\",\"2.1\",\"2.2\",\"2.3\",\"2.4\",\"2.5\",\"2.6\",\"2.7\",\"2.8\",\"2.9\",\"2.10\",\"2.11\",\"2.12\",\"2.13\",\"2.14\",\"2.15\",\"2.16\"],\"example\":\"2.16\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"redirect_created\":{\"summary\":\"redirect created\",\"value\":{\"from_url\":\"http://help-center.test/lovelyhelpcenter/old-page\",\"locale\":\"en\",\"target_id\":\"11\",\"target_type\":\"article\"}}},\"schema\":{\"description\":\"You can create a help center redirect.\",\"properties\":{\"from_url\":{\"description\":\"The source URL to redirect. Must be an absolute URL within the help center's URL space.\",\"example\":\"http://help-center.test/lovelyhelpcenter/old-page\",\"type\":\"string\"},\"locale\":{\"description\":\"The locale of the target translation (e.g. `en`, `fr`). For article targets this selects the ArticleContent variant.\",\"example\":\"en\",\"type\":\"string\"},\"target_id\":{\"description\":\"The unique identifier of the target article or collection. The target must be a member of the help center.\",\"example\":\"11\",\"type\":\"string\"},\"target_type\":{\"description\":\"The type of the redirect target.\",\"enum\":[\"article\",\"collection\"],\"example\":\"article\",\"type\":\"string\"}},\"required\":[\"from_url\",\"locale\",\"target_type\",\"target_id\"],\"title\":\"Create Help Center Redirect Request Payload\",\"type\":\"object\"}}}},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"redirect created\":{\"value\":{\"created_at\":1781619405,\"from_url\":\"http://help-center.test/lovelyhelpcenter/old-page\",\"help_center_id\":\"7\",\"id\":\"26\",\"locale\":\"en\",\"target_id\":\"11\",\"target_type\":\"article\",\"type\":\"help_center_redirect\",\"updated_at\":1781619405}}},\"schema\":{\"description\":\"A redirect maps a source URL (`from_url`) to an article or collection within a\\nhelp center, so that links to old or external URLs resolve to live content.\\n\",\"properties\":{\"created_at\":{\"description\":\"The time the redirect was created as a UTC Unix timestamp.\",\"example\":1781619405,\"type\":\"integer\"},\"from_url\":{\"description\":\"The source URL that is redirected. An absolute URL within the help center's URL space.\",\"example\":\"http://help-center.test/lovelyhelpcenter/old-page\",\"type\":\"string\"},\"help_center_id\":{\"description\":\"The unique identifier for the help center the redirect belongs to.\",\"example\":\"7\",\"type\":\"string\"},\"id\":{\"description\":\"The unique identifier for the redirect.\",\"example\":\"26\",\"type\":\"string\"},\"locale\":{\"description\":\"The locale of the redirect's target. For article targets this is the bound translation's locale, which may differ from the requested locale if no translation exists in that locale.\",\"example\":\"en\",\"type\":\"string\"},\"target_id\":{\"description\":\"The unique identifier of the target article or collection. For article targets this is the Article ID.\",\"example\":\"11\",\"type\":\"string\"},\"target_type\":{\"description\":\"The type of the redirect target.\",\"enum\":[\"article\",\"collection\"],\"example\":\"article\",\"type\":\"string\"},\"type\":{\"description\":\"The type of the object - `help_center_redirect`.\",\"enum\":[\"help_center_redirect\"],\"example\":\"help_center_redirect\",\"type\":\"string\"},\"updated_at\":{\"description\":\"The time the redirect was last updated as a UTC Unix timestamp.\",\"example\":1781619405,\"type\":\"integer\"}},\"title\":\"Help Center Redirect\",\"type\":\"object\"}}},\"description\":\"redirect created\"},\"400\":{\"content\":{\"application/json\":{\"examples\":{\"Invalid target_type\":{\"value\":{\"errors\":[{\"code\":\"parameter_invalid\",\"message\":\"target_type must be 'article' or 'collection'\"}],\"request_id\":\"816186b3-3187-4b47-adf8-e201bea32209\",\"type\":\"error.list\"}},\"Missing parameter\":{\"value\":{\"errors\":[{\"code\":\"parameter_not_found\",\"message\":\"from_url is required\"}],\"request_id\":\"816186b3-3187-4b47-adf8-e201bea32208\",\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"errors\":{\"description\":\"An array of one or more error objects\",\"items\":{\"properties\":{\"code\":{\"description\":\"A string indicating the kind of error, used to further qualify the HTTP response code\",\"example\":\"unauthorized\",\"type\":\"string\"},\"field\":{\"description\":\"Optional. Used to identify a particular field or query parameter that was in error.\",\"example\":\"email\",\"nullable\":true,\"type\":\"string\"},\"message\":{\"description\":\"Optional. Human readable description of the error.\",\"example\":\"Access Token Invalid\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"code\"]},\"type\":\"array\"},\"request_id\":{\"description\":\"\",\"example\":\"f93ecfa8-d08a-4325-8694-89aeb89c8f85\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type is error.list\",\"example\":\"error.list\",\"type\":\"string\"}},\"required\":[\"type\",\"errors\"],\"title\":\"Error\",\"type\":\"object\"}}},\"description\":\"Bad Request\"},\"401\":{\"content\":{\"application/json\":{\"examples\":{\"Unauthorized\":{\"value\":{\"errors\":[{\"code\":\"unauthorized\",\"message\":\"Access Token Invalid\"}],\"request_id\":\"25d96ec2-641f-4354-b24e-83a85d33bd30\",\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"$ref\":\"#/responses/400/content/application~1json/schema/properties\"},\"required\":{\"$ref\":\"#/responses/400/content/application~1json/schema/required\"},\"title\":\"Error\",\"type\":\"object\"}}},\"description\":\"Unauthorized\"},\"404\":{\"content\":{\"application/json\":{\"examples\":{\"Not Found\":{\"value\":{\"errors\":[{\"code\":\"not_found\",\"message\":\"Resource not found\"}],\"request_id\":\"55d96ec2-641f-4354-b24e-83a85d33bd33\",\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"$ref\":\"#/responses/400/content/application~1json/schema/properties\"},\"required\":{\"$ref\":\"#/responses/400/content/application~1json/schema/required\"},\"title\":\"Error\",\"type\":\"object\"}}},\"description\":\"Help center not found\"},\"409\":{\"content\":{\"application/json\":{\"examples\":{\"Conflict\":{\"value\":{\"errors\":[{\"code\":\"resource_conflict\",\"message\":\"A redirect with that URL already exists\"}],\"request_id\":\"35d96ec2-641f-4354-b24e-83a85d33bd31\",\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"$ref\":\"#/responses/400/content/application~1json/schema/properties\"},\"required\":{\"$ref\":\"#/responses/400/content/application~1json/schema/required\"},\"title\":\"Error\",\"type\":\"object\"}}},\"description\":\"Conflict\"},\"422\":{\"content\":{\"application/json\":{\"examples\":{\"Invalid data\":{\"value\":{\"errors\":[{\"code\":\"data_invalid\",\"message\":\"from_url must be an absolute URL within this help center's URL space\"}],\"request_id\":\"45d96ec2-641f-4354-b24e-83a85d33bd32\",\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"$ref\":\"#/responses/400/content/application~1json/schema/properties\"},\"required\":{\"$ref\":\"#/responses/400/content/application~1json/schema/required\"},\"title\":\"Error\",\"type\":\"object\"}}},\"description\":\"Unprocessable Entity\"}},\"security\":[{\"bearerAuth\":[]}],\"securitySchemes\":{\"bearerAuth\":{\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"definition\"}"
