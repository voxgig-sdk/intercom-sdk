            json: "{\"operationId\":\"listHelpCenters\",\"parameters\":[{\"in\":\"header\",\"name\":\"Intercom-Version\",\"schema\":{\"default\":\"2.16\",\"description\":\"Intercom API version.</br>By default, it's equal to the version set in the app package.\",\"enum\":[\"1.0\",\"1.1\",\"1.2\",\"1.3\",\"1.4\",\"2.0\",\"2.1\",\"2.2\",\"2.3\",\"2.4\",\"2.5\",\"2.6\",\"2.7\",\"2.8\",\"2.9\",\"2.10\",\"2.11\",\"2.12\",\"2.13\",\"2.14\",\"2.15\",\"2.16\"],\"example\":\"2.16\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"Help Centers found\":{\"value\":{\"data\":[],\"type\":\"list\"}}},\"schema\":{\"description\":\"A list of Help Centers belonging to the App\",\"properties\":{\"data\":{\"description\":\"An array of Help Center objects\",\"items\":{\"description\":\"Help Centers contain collections\",\"properties\":{\"created_at\":{\"description\":\"The time when the Help Center was created.\",\"example\":1672928359,\"format\":\"date-time\",\"type\":\"integer\"},\"custom_domain\":{\"description\":\"Custom domain configured for the help center\",\"example\":\"help.mycompany.com\",\"nullable\":true,\"type\":\"string\"},\"default\":{\"description\":\"Whether this help center is the default for the workspace.\",\"example\":false,\"type\":\"boolean\"},\"display_name\":{\"description\":\"The display name of the Help Center only seen by teammates.\",\"example\":\"Intercom Help Center\",\"type\":\"string\"},\"id\":{\"description\":\"The unique identifier for the Help Center which is given by Intercom.\",\"example\":\"123\",\"type\":\"string\"},\"identifier\":{\"description\":\"The identifier of the Help Center. This is used in the URL of the Help Center.\",\"example\":\"intercom\",\"type\":\"string\"},\"locales\":{\"description\":\"The locales in which the help center is available.\",\"example\":[\"en\",\"fr\"],\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"updated_at\":{\"description\":\"The time when the Help Center was last updated.\",\"example\":1672928610,\"format\":\"date-time\",\"type\":\"integer\"},\"url\":{\"description\":\"The URL for the help center, if you have a custom domain then this will show the URL using the custom domain.\",\"example\":\"https://help.mycompany.com\",\"type\":\"string\"},\"website_turned_on\":{\"description\":\"Whether the Help Center is turned on or not. This is controlled in your Help Center settings.\",\"example\":true,\"type\":\"boolean\"},\"workspace_id\":{\"description\":\"The id of the workspace which the Help Center belongs to.\",\"example\":\"hfi1bx4l\",\"type\":\"string\"}},\"title\":\"Help Center\",\"type\":\"object\"},\"type\":\"array\"},\"type\":{\"description\":\"The type of the object - `list`.\",\"enum\":[\"list\"],\"example\":\"list\",\"type\":\"string\"}},\"title\":\"Help Centers\",\"type\":\"object\"}}},\"description\":\"Help Centers found\"},\"401\":{\"content\":{\"application/json\":{\"examples\":{\"Unauthorized\":{\"value\":{\"errors\":[{\"code\":\"unauthorized\",\"message\":\"Access Token Invalid\"}],\"request_id\":\"76edbbb7-e463-4f6a-817a-b7905d467535\",\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"errors\":{\"description\":\"An array of one or more error objects\",\"items\":{\"properties\":{\"code\":{\"description\":\"A string indicating the kind of error, used to further qualify the HTTP response code\",\"example\":\"unauthorized\",\"type\":\"string\"},\"field\":{\"description\":\"Optional. Used to identify a particular field or query parameter that was in error.\",\"example\":\"email\",\"nullable\":true,\"type\":\"string\"},\"message\":{\"description\":\"Optional. Human readable description of the error.\",\"example\":\"Access Token Invalid\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"code\"]},\"type\":\"array\"},\"request_id\":{\"description\":\"\",\"exa