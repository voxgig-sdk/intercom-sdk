irect.\",\"example\":\"26\",\"type\":\"string\"},\"locale\":{\"description\":\"The locale of the redirect's target. For article targets this is the bound translation's locale, which may differ from the requested locale if no translation exists in that locale.\",\"example\":\"en\",\"type\":\"string\"},\"target_id\":{\"description\":\"The unique identifier of the target article or collection. For article targets this is the Article ID.\",\"example\":\"11\",\"type\":\"string\"},\"target_type\":{\"description\":\"The type of the redirect target.\",\"enum\":[\"article\",\"collection\"],\"example\":\"article\",\"type\":\"string\"},\"type\":{\"description\":\"The type of the object - `help_center_redirect`.\",\"enum\":[\"help_center_redirect\"],\"example\":\"help_center_redirect\",\"type\":\"string\"},\"updated_at\":{\"description\":\"The time the redirect was last updated as a UTC Unix timestamp.\",\"example\":1781619405,\"type\":\"integer\"}},\"title\":\"Help Center Redirect\",\"type\":\"object\"}}},\"description\":\"Successful\"},\"401\":{\"content\":{\"application/json\":{\"examples\":{\"Unauthorized\":{\"value\":{\"errors\":[{\"code\":\"unauthorized\",\"message\":\"Access Token Invalid\"}],\"request_id\":\"12c2d3a0-77ef-462e-a5ed-e67ddff50b6e\",\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"errors\":{\"description\":\"An array of one or more error objects\",\"items\":{\"properties\":{\"code\":{\"description\":\"A string indicating the kind of error, used to further qualify the HTTP response code\",\"example\":\"unauthorized\",\"type\":\"string\"},\"field\":{\"description\":\"Optional. Used to identify a particular field or query parameter that was in error.\",\"example\":\"email\",\"nullable\":true,\"type\":\"string\"},\"message\":{\"description\":\"Optional. Human readable description of the error.\",\"example\":\"Access Token Invalid\",