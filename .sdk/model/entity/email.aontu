# Entity: email

main: kit: entity: email: {

  alias: field: {}

  fields: {
    brand_id: {
      h: "Brand Id"
      n: "brand_id"
      r: false
      sh: "Associated brand identifier"
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      sh: "Unix timestamp of creation"
      t: "`$INTEGER`"
    }
    domain: {
      h: "Domain"
      n: "domain"
      r: false
      sh: "Domain portion of the email address"
      t: "`$STRING`"
    }
    email: {
      h: "Email"
      n: "email"
      r: false
      sh: "Full sender email address"
      t: "`$STRING`"
    }
    forwarded_email_last_received_at: {
      fo: "date-time"
      h: "Forwarded Email Last Received At"
      n: "forwarded_email_last_received_at"
      r: false
      sh: "Unix timestamp of last forwarded email received (null if never)"
      t: "`$INTEGER`"
    }
    forwarding_enabled: {
      h: "Forwarding Enabled"
      n: "forwarding_enabled"
      r: false
      sh: "Whether email forwarding is active"
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique email setting identifier"
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "The type of object"
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "Unix timestamp of last modification"
      t: "`$INTEGER`"
    }
    verified: {
      h: "Verified"
      n: "verified"
      r: false
      sh: "Whether the email address has been verified"
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "email"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /emails"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                ex: "2.16"
                k: "header"
                n: "intercom_version"
                or: "intercom_version"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/emails"
          q: {
            exist: [
              "intercom_version"
            ]
          }
          s: [
            {
              lit: "emails"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /emails/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                ex: "2.16"
                k: "header"
                n: "intercom_version"
                or: "intercom_version"
                r: false
                t: "`$STRING`"
              }
            ]
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/emails/{id}"
          q: {
            exist: [
              "id"
              "intercom_version"
            ]
          }
          s: [
            {
              lit: "emails"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
