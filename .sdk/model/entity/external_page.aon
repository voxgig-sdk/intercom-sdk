            ]
          }
          contract: {
            id: "POST /ai/external_pages"
            json: "{\"operationId\":\"createExternalPage\",\"parameters\":[{\"in\":\"header\",\"name\":\"Intercom-Version\",\"schema\":{\"default\":\"2.16\",\"description\":\"Intercom API version.</br>By default, it's equal to the version set in the app package.\",\"enum\":[\"1.0\",\"1.1\",\"1.2\",\"1.3\",\"1.4\",\"2.0\",\"2.1\",\"2.2\",\"2.3\",\"2.4\",\"2.5\",\"2.6\",\"2.7\",\"2.8\",\"2.9\",\"2.10\",\"2.11\",\"2.12\",\"2.13\",\"2.14\",\"2.15\",\"2.16\"],\"example\":\"2.16\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"successful\":{\"summary\":\"successful\",\"value\":{\"external_id\":\"abc1234\",\"html\":\"<html><body><h1>Test</h1></body></html>\",\"locale\":\"en\",\"source_id\":44,\"title\":\"Test\",\"url\":\"https://www.example.com\"}}},\"schema\":{\"description\":\"You can add an External Page to your Fin Content Library.\",\"nullable\":false,\"properties\":{\"ai_agent_availability\":{\"default\":false,\"description\":\"Whether the external page should be used to answer questions by AI Agent. Will not default when updating an existing external page.\",\"example\":true,\"type\":\"boolean\"},\"ai_copilot_availability\":{\"default\":false,\"description\":\"Whether the external page should be used to answer questions by AI Copilot. Will not default when updating an existing external page.\",\"example\":true,\"type\":\"boolean\"},\"external_id\":{\"description\":\"The identifier for the external page which was given by the source. Must be unique for the source.\",\"example\":\"5678\",\"type\":\"string\"},\"html\":{\"description\":\"The body of the external page in HTML.\",\"example\":\"<p>Hello world!</p>\",\"type\":\"string\"},\"locale\":{\"default\":\"en\",\"description\":\"Always en\",\"enum\":[\"en\"],\"example\":\"en\",\"type\":\"string\"},\"source_id\":{\"description\":\"The unique identifier for the source of the external page which was given by Intercom. Every external page must be associated with a Content Import Source which represents the place it comes from and from which it inherits a default audience (configured in the UI). For a new source, make a POST request to the Content Import Source endpoint and an ID for the source will be returned in the response.\",\"example\":1234,\"type\":\"integer\"},\"title\":{\"description\":\"The title of the external page.\",\"example\":\"Getting started with...\",\"type\":\"string\"},\"url\":{\"description\":\"The URL of the external page. This will be used by Fin to link end users to the page it based its answer on. When a URL is not present, Fin will not reference the source.\",\"example\":\"https://help.example.com/en/articles/1234-getting-started\",\"type\":\"string\"}},\"required\":[\"title\",\"html\",\"locale\",\"source_id\",\"external_id\"],\"title\":\"Create External Page Payload\",\"type\":\"object\"}}}},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"successful\":{\"value\":{\"ai_agent_availability\":true,\"ai_copilot_availability\":true,\"ai_sales_agent_availability\":true,\"created_at\":1734537273,\"external_id\":\"abc1234\",\"fin_availability\":true,\"html\":\"<html><body><h1>Test</h1></body></html>\",\"id\":\"21\",\"last_ingested_at\":1734537274,\"locale\":\"en\",\"source_id\":44,\"title\":\"Test\",\"type\":\"external_page\",\"updated_at\":1734537274,\"url\":\"https://www.example.com\"}}},\"schema\":{\"description\":\"External pages that you have added to your Fin Content Library.\",\"nullable\":false,\"properties\":{\"ai_agent_availability\":{\"description\":\"Whether the external page should be used to answer questions by AI Agent.\",\"example\":true,\"type\":\"boolean\"},\"ai_copilot_availability\":{\"description\":\"Whether the external page should be used to answer questions by AI Copilot.\",\"example\":true,\"type\":\"boolean\"},\"ai_sales_agent_availability\":{\"description\":\"Whether the external page should be used to answer questions by AI Sales Agent.\",\"example\":true,\"type\":\"boolean\"},\"created_at\":{\"description\":\"The time when the external page was created.\",\"example\":1672928359,\"format\":\"date-time\",\"type\":\"integer\"},\"external_id\":{\"description\":\"The identifier for the external page which was given by the source. Must be unique for the source.\",\"example\":\"5678\",\"type\":\"string\"},\"fin_availability\":{\"description\":\"Deprecated. Use ai_agent_availability and ai_copilot_availability instead.\",\"example\":true,\"type\":\"boolean\"},\"html\":{\"description\":\"The body of the external page in HTML.\",\"example\":\"<p>Hello world!</p>\",\"type\":\"string\"},\"id\":{\"description\":\"The unique identifier for the external page which is given by Intercom.\",\"example\":\"1234\",\"type\":\"string\"},\"last_ingested_at\":{\"description\":\"The time when the external page was last ingested.\",\"example\":1672928610,\"format\":\"date-time\",\"type\":\"integer\"},\"locale\":{\"default\":\"en\",\"description\":\"Always en\",\"enum\":[\"en\"],\"example\":\"en\",\"type\":\"string\"},\"source_id\":{\"description\":\"The unique identifier for the source of the external page which was given by Intercom. Every external page must be associated with a Content Import Source which represents the place it comes from and from which it inherits a default audience (configured in the UI). For a new source, make a POST request to the Content Import Source endpoint and an ID for the source will be returned in the response.\",\"example\":1234,\"type\":\"integer\"},\"title\":{\"description\":\"The title of the external page.\",\"example\":\"Getting started with...\",\"type\":\"string\"},\"type\":{\"default\":\"external_page\",\"description\":\"Always external_page\",\"enum\":[\"external_page\"],\"example\":\"external_page\",\"type\":\"string\"},\"updated_at\":{\"description\":\"The time when the external page was last updated.\",\"example\":1672928610,\"format\":\"date-time\",\"type\":\"integer\"},\"url\":{\"description\":\"The URL of the external page. This will be used by Fin to link end users to the page it based its answer on.\",\"example\":\"https://help.example.com/en/articles/1234-getting-started\",\"type\":\"string\"}},\"required\":[\"id\",\"type\",\"title\",\"html\",\"ai_agent_availability\",\"ai_copilot_availability\",\"locale\",\"source_id\",\"created_at\",\"updated_at\",\"last_ingested_at\",\"external_id\"],\"title\":\"External Page\",\"type\":\"object\"}}},\"description\":\"successful\"},\"401\":{\"content\":{\"application/json\":{\"examples\":{\"Unauthorized\":{\"value\":{\"errors\":[{\"code\":\"unauthorized\",\"message\":\"Access Token Invalid\"}],\"request_id\":\"205ffc13-1b25-43b2-a176-cb817af5f899\",\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"errors\":{\"description\":\"An array of one or more error objects\",\"items\":{\"properties\":{\"code\":{\"description\":\"A string indicating the kind of error, used to further qualify the HTTP response code\",\"example\":\"unauthorized\",\"type\":\"string\"},\"field\":{\"description\":\"Optional. Used to identify a particular field or query parameter that was in error.\",\"example\":\"email\",\"nullable\":true,\"type\":\"string\"},\"message\":{\"description\":\"Optional. Human readable description of the error.\",\"example\":\"Access Token Invalid\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"code\"]},\"type\":\"array\"},\"request_id\":{\"description\":\"\",\"example\":\"f93ecfa8-d08a-4325-8694-89aeb89c8f85\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type is error.list\",\"example\":\"error.list\",\"type\":\"string\"}},\"required\":[\"type\",\"errors\"],\"title\":\"Error\",\"type\":\"object\"}}},\"description\":\"Unauthorized\"}},\"security\":[{\"bearerAuth\":[]}],\"securitySchemes\":{\"bearerAuth\":{\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"definition\"}"
