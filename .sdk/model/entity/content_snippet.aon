with no partial commit.\",\"example\":[1,2],\"items\":{\"type\":\"integer\"},\"nullable\":true,\"type\":\"array\"},\"body_markdown\":{\"description\":\"The content of the snippet in markdown. An alternative to `json_blocks` — you can provide content as markdown instead of structured blocks. Mutually exclusive with `json_blocks`.\",\"example\":\"## Updated heading\\n\\nNew content.\\n\",\"type\":\"string\"},\"json_blocks\":{\"description\":\"The content blocks that make up the body of the snippet. Mutually exclusive with `body_markdown`.\",\"example\":[{\"text\":\"Navigate to Settings > Security > Reset password.\",\"type\":\"paragraph\"}],\"items\":{\"type\":\"object\"},\"type\":\"array\"},\"locale\":{\"description\":\"The locale of the content snippet.\",\"example\":\"en\",\"type\":\"string\"},\"title\":{\"description\":\"The title of the content snippet.\",\"example\":\"How to reset your password\",\"maxLength\":255,\"type\":\"string\"}},\"title\":\"Update Content Snippet Request\",\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"Content snippet updated\":{\"value\":{\"ai_chatbot_availability\":true,\"ai_copilot_availability\":true,\"ai_sales_agent_availability\":true,\"audience_ids\":[1,2],\"body_markdown\":\"# How to reset your password (updated)\\n\\nGo to Settings > Security > Reset password and follow the steps.\\n\",\"chatbot_availability\":1,\"copilot_availability\":1,\"created_at\":1663597223,\"id\":\"123\",\"json_blocks\":[{\"text\":\"Go to Settings > Security > Reset password and follow the steps.\",\"type\":\"paragraph\"}],\"locale\":\"en\",\"title\":\"How to reset your password (updated)\",\"type\":\"content_snippet\",\"updated_at\":1663597300}}},\"schema\":{\"description\":\"A content snippet is a reusable piece of content for your AI agent and Copilot.\",\"nullable\":false,\"properties\":{\"ai_chatbot_availability\":{\"description\":\"Whether the content snippet is available for AI Chatbot (Fin).\",\"example\":true,\"type\":\"boolean\"},\"ai_copilot_availability\":{\"description\":\"Whether the content snippet is available for AI Copilot.\",\"example\":true,\"type\":\"boolean\"},\"ai_sales_agent_availability\":{\"description\":\"Whether the content snippet is available for AI Sales Agent.\",\"example\":true,\"type\":\"boolean\"},\"audience_ids\":{\"description\":\"The list of audience IDs this content snippet is targeted to for Fin AI Agent. Empty array means no audience targeting is set.\",\"example\":[1,2],\"items\":{\"type\":\"integer\"},\"nullable\":true,\"type\":\"array\"},\"body_markdown\":{\"description\":\"The body of the content snippet in markdown.\",\"example\":\"# How to reset your password\\n\\nNavigate to Settings > Security > Reset password.\\n\",\"nullable\":true,\"type\":\"string\"},\"chatbot_availability\":{\"deprecated\":true,\"description\":\"Deprecated. Use ai_chatbot_availability instead. Whether this snippet is available for Fin (1 = on, 0 = off).\",\"example\":1,\"type\":\"integer\"},\"copilot_availability\":{\"deprecated\":true,\"description\":\"Deprecated. Use ai_copilot_availability instead. Whether this snippet is available for Copilot (1 = on, 0 = off).\",\"example\":1,\"type\":\"integer\"},\"created_at\":{\"description\":\"The time the snippet was created as a UNIX timestamp.\",\"example\":1663597223,\"type\":\"integer\"},\"id\":{\"description\":\"The unique identifier for the content snippet.\",\"example\":\"123\",\"type\":\"string\"},\"json_blocks\":{\"description\":\"The content blocks that make up the body of the snippet.\",\"example\":[{\"text\":\"Navigate to Settings > Security > Reset password.\",\"type\":\"paragraph\"}],\"items\":{\"type\":\"object\"},\"type\":\"array\"},\"locale\":{\"description\":\"The locale of the content snippet.\",\"example\":\"en\",\"type\":\"string\"},\"title\":{\"description\":\"The title of the content snippet.\",\"example\":\"How to reset your password\",\"nullable\":true,\"type\":\"string\"},\"type\":{\"description\":\"String representing the object's type. Always has the value `content_snippet`.\",\"example\":\"content_snippet\",\"type\":\"string\"},\"updated_at\":{\"description\":\"The time the snippet was last updated as a UNIX timestamp.\",\"example\":1663597223,\"type\":\"integer\"}},\"title\":\"Content Snippet\",\"type\":\"object\"}}},\"description\":\"Content snippet updated\"},\"404\":{\"content\":{\"application/json\":{\"examples\":{\"Content snippet not found\":{\"value\":{\"errors\":[{\"code\":\"not_found\",\"message\":\"Content snippet not found\"}],\"type\":\"error.list\"}},\"Unknown audience IDs\":{\"value\":{\"errors\":[{\"code\":\"parameter_invalid\",\"message\":\"audience_ids contains unknown audience IDs: 999\"}],\"type\":\"error.list\"}}},\"schema\":{\"description\":\"The API will return an Error List for a failed request, which will contain one or more Error objects.\",\"properties\":{\"errors\":{\"description\":\"An array of one or more error objects\",\"items\":{\"properties\":{\"code\":{\"description\":\"A string indicating the kind of error, used to further qualify the HTTP response code\",\"example\":\"unauthorized\",\"type\":\"string\"},\"field\":{\"description\":\"Optional. Used to identify a particular field or query parameter that was in error.\",\"example\":\"email\",\"nullable\":true,\"type\":\"string\"},\"message\":{\"description\":\"Optional. Human readable description of the error.\",\"example\":\"Access Token Invalid\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"code\"]},\"type\":\"array\"},\"request_id\":{\"description\":\"\",\"example\":\"f93ecfa8-d08a-4325-8694-89aeb89c8f85\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type is error.list\",\"example\":\"error.list\",\"type\":\"string\"}},\"required\":[\"type\",\"errors\"],\"title\":\"Error\",\"type\":\"object\"}}},\"description\":\"Content snippet or audience ID not found\"},\"422\":{\"content\