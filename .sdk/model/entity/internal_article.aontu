      sh: "Whether the internal article is available for AI Sales Agent."
      t: "`$BOOLEAN`"
    }
    audience_ids: {
      h: "Audience Ids"
      n: "audience_ids"
      r: false
      sh: "The list of audience IDs this internal article is targeted to for Fin AI Agent."
      t: "`$ARRAY`"
    }
    author_id: {
      h: "Author Id"
      n: "author_id"
      r: false
      sh: "The id of the author of the article."
      t: "`$INTEGER`"
    }
    body: {
      h: "Body"
      n: "body"
      r: false
      sh: "The body of the article in HTML."
      t: "`$STRING`"
    }
    body_markdown: {
      h: "Body Markdown"
      n: "body_markdown"
      r: false
      sh: "The body of the article in markdown."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      sh: "The time when the article was created."
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The unique identifier for the article which is given by Intercom."
      t: "`$STRING`"
    }
    locale: {
      h: "Locale"
      n: "locale"
      r: false
      sh: "The default locale of the article."
      t: "`$STRING`"
    }
    owner_id: {
      h: "Owner Id"
      n: "owner_id"
      r: false
      sh: "The id of the owner of the article."
      t: "`$INTEGER`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      sh: "The title of the article."
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "The type of object - `internal_article`."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "The time when the article was last updated."
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "internal_article"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /internal_articles/{internal_article_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                ex: "2.16"
                k: "header"
                n: "intercom_version"
                or: "intercom_version"
                r: false
                t: "`$STRING`"
              }
            ]
            params: [
              {
                ex: 123
                k: "param"
                n: "id"
                or: "internal_article_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/internal_articles/{internal_article_id}"
          q: {
            exist: [
              "id"
              "intercom_version"
            ]
          }
          r: {
            param: {
              internal_article_id: "id"
            }
          }
          s: [
            {
              lit: "internal_articles"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PUT /internal_articles/{internal_article_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                ex: "2.16"
                k: "header"
                n: "intercom_version"
                or: "intercom_version"
                r: false
                t: "`$STRING`"
              }
            ]
            params: [
              {
                ex: 123
                k: "param"
                n: "id"
                or: "internal_article_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "PUT"
          o: "/internal_articles/{internal_article_id}"
          q: {
            exist: [
              "id"
              "intercom_version"
            ]
          }
          r: {
            param: {
              internal_article_id: "id"
            }
          }
          s: [
            {
              lit: "internal_articles"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



