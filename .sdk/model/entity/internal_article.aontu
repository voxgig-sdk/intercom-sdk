# Entity: internal_article

main: kit: entity: internal_article: {

  alias: field: {}

  fields: {
    ai_chatbot_availability: {
      h: "Ai Chatbot Availability"
      n: "ai_chatbot_availability"
      r: false
      sh: "Whether the internal article is available for AI Chatbot (Fin)."
      t: "`$BOOLEAN`"
    }
    ai_copilot_availability: {
      h: "Ai Copilot Availability"
      n: "ai_copilot_availability"
      r: false
      sh: "Whether the internal article is available for AI Copilot."
      t: "`$BOOLEAN`"
    }
    ai_sales_agent_availability: {
      h: "Ai Sales Agent Availability"
      n: "ai_sales_agent_availability"
