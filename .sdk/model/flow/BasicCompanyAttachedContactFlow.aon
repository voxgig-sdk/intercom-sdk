# BasicCompanyAttachedContactFlow

main: kit: flow: BasicCompanyAttachedContactFlow:
{
  entity: "company_attached_contact",
  kind: "basic",
  name: "BasicCompanyAttachedContactFlow",
  step: [
    {
      match: {
        company_id: "company01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "company_attached_contact_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCompanyAttachedContactFlow"
}