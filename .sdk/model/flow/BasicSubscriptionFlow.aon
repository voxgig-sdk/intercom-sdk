# BasicSubscriptionFlow

main: kit: flow: BasicSubscriptionFlow:
{
  entity: "subscription",
  kind: "basic",
  name: "BasicSubscriptionFlow",
  step: [
    {
      input: {
        ref: "subscription_ref01"
      }

      match: {
        contact_id: "contact01"
      }

      op: "create"
    }

    {
      match: {
        contact_id: "contact01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "subscription_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "subscription_ref01",
        suffix: "_rm0"
      }

      match: {
        contact_id: "contact01",
        id: "subscription01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        contact_id: "contact01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "subscription_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSubscriptionFlow"
}