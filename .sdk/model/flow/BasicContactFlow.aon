# BasicContactFlow

main: kit: flow: BasicContactFlow:
{
  entity: "contact",
  kind: "basic",
  name: "BasicContactFlow",
  step: [
    {
      input: {
        ref: "contact_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "contact_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "contact_ref01",
        srcdatavar: "contact_ref01_data",
        suffix: "_up0",
        textfield: "android_app_name"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-contact_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "contact_ref01",
        srcdatavar: "contact_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "contact01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-contact_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "contact_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "contact01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "contact_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicContactFlow"
}