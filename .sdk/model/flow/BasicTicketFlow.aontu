# BasicTicketFlow

main: kit: flow: BasicTicketFlow:
{
  entity: "ticket",
  kind: "basic",
  name: "BasicTicketFlow",
  step: [
    {
      i: {
        ref: "ticket_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "ticket_ref01",
        srcdatavar: "ticket_ref01_data",
        suffix: "_up0",
        textfield: "category"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ticket_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "ticket_ref01",
        srcdatavar: "ticket_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "ticket01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ticket_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "ticket_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "ticket01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicTicketFlow"
}