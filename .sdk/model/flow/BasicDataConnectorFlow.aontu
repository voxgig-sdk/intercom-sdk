# BasicDataConnectorFlow

main: kit: flow: BasicDataConnectorFlow:
{
  entity: "data_connector",
  kind: "basic",
  name: "BasicDataConnectorFlow",
  step: [
    {
      i: {
        ref: "data_connector_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "data_connector_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "data_connector_ref01",
        srcdatavar: "data_connector_ref01_data",
        suffix: "_up0",
        textfield: "body"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-data_connector_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "data_connector_ref01",
        srcdatavar: "data_connector_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "data_connector01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-data_connector_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDataConnectorFlow"
}