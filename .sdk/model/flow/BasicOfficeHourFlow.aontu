# BasicOfficeHourFlow

main: kit: flow: BasicOfficeHourFlow:
{
  entity: "office_hour",
  kind: "basic",
  name: "BasicOfficeHourFlow",
  step: [
    {
      i: {
        ref: "office_hour_ref01"
      }

      m: {
        office_hours_schedule_id: "office_hours_schedule01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "office_hour_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "office_hour_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "office_hour01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "office_hour_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOfficeHourFlow"
}