# BasicSideConversationFlow

main: kit: flow: BasicSideConversationFlow:
{
  entity: "side_conversation",
  kind: "basic",
  name: "BasicSideConversationFlow",
  step: [
    {
      match: {
        conversation_id: "conversation01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "side_conversation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSideConversationFlow"
}