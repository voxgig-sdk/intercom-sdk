# BasicNoteFlow

main: kit: flow: BasicNoteFlow:
{
  entity: "note",
  kind: "basic",
  name: "BasicNoteFlow",
  step: [
    {
      i: {
        ref: "note_ref01"
      }

      m: {
        company_id: "company01",
        contact_id: "contact01"
      }

      o: "create"
    }

    {
      m: {
        contact_id: "contact01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "note_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "note_ref01",
        srcdatavar: "note_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "note01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-note_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicNoteFlow"
}