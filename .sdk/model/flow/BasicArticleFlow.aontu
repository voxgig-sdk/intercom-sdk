# BasicArticleFlow

main: kit: flow: BasicArticleFlow:
{
  entity: "article",
  kind: "basic",
  name: "BasicArticleFlow",
  step: [
    {
      i: {
        ref: "article_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "article_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "article_ref01",
        srcdatavar: "article_ref01_data",
        suffix: "_up0",
        textfield: "body"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-article_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "article_ref01",
        srcdatavar: "article_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "article01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-article_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicArticleFlow"
}