# BasicHelpCenterFlow

main: kit: flow: BasicHelpCenterFlow:
{
  entity: "help_center",
  kind: "basic",
  name: "BasicHelpCenterFlow",
  step: [
    {
      i: {
        ref: "help_center_ref01"
      }

      m: {
        help_center_id: "help_center01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "help_center_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "help_center_ref01",
        srcdatavar: "help_center_ref01_data",
        suffix: "_up0",
        textfield: "custom_domain"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-help_center_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "help_center_ref01",
        srcdatavar: "help_center_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "help_center01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-help_center_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "help_center_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "help_center01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "help_center_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicHelpCenterFlow"
}