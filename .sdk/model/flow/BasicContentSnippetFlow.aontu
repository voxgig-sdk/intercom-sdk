# BasicContentSnippetFlow

main: kit: flow: BasicContentSnippetFlow:
{
  entity: "content_snippet",
  kind: "basic",
  name: "BasicContentSnippetFlow",
  step: [
    {
      i: {
        ref: "content_snippet_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "content_snippet_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "content_snippet_ref01",
        srcdatavar: "content_snippet_ref01_data",
        suffix: "_up0",
        textfield: "body_markdown"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-content_snippet_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "content_snippet_ref01",
        srcdatavar: "content_snippet_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "content_snippet01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-content_snippet_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "content_snippet_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "content_snippet01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "content_snippet_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicContentSnippetFlow"
}