# BasicSubscriptionFlow

main: kit: flow: BasicSubscriptionFlow:
{
  entity: "subscription",
  kind: "basic",
  name: "BasicSubscriptionFlow",
  step: [
    {
      i: {
        ref: "subscription_ref01"
      }

      m: {
        contact_id: "contact01"
      }

      o: "create"
    }

    {
      m: {
        contact_id: "contact01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "subscription_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "subscription_ref01",
        suffix: "_rm0"
      }

      m: {
        contact_id: "contact01",
        id: "subscription01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        contact_id: "contact01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "subscription_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSubscriptionFlow"
}