# BasicCallFlow

main: kit: flow: BasicCallFlow:
{
  entity: "call",
  kind: "basic",
  name: "BasicCallFlow",
  step: [
    {
      input: {
        ref: "call_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "call_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "call_ref01",
        srcdatavar: "call_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "call01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-call_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCallFlow"
}