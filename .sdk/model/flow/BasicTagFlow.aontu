# BasicTagFlow

main: kit: flow: BasicTagFlow:
{
  entity: "tag",
  kind: "basic",
  name: "BasicTagFlow",
  step: [
    {
      i: {
        ref: "tag_ref01"
      }

      m: {
        article_id: "article01",
        contact_id: "contact01",
        content_snippet_id: "content_snippet01",
        conversation_id: "conversation01",
        internal_article_id: "internal_article01",
        ticket_id: "ticket01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "tag_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "tag_ref01",
        srcdatavar: "tag_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "tag01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-tag_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "tag_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "tag01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "tag_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTagFlow"
}